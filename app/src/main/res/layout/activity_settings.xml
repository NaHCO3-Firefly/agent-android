<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="提供商"
        android:textSize="14sp"
        android:textColor="?android:textColorSecondary"
        android:layout_marginBottom="4dp" />

    <Spinner
        android:id="@+id/spinner_provider"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginBottom="16dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="API 地址"
        android:textSize="14sp"
        android:textColor="?android:textColorSecondary"
        android:layout_marginBottom="4dp" />

    <EditText
        android:id="@+id/edit_base_url"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:inputType="textUri"
        android:hint="https://api.openai.com/v1"
        android:layout_marginBottom="16dp"
        android:paddingStart="12dp"
        android:paddingEnd="12dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="API 密钥"
        android:textSize="14sp"
        android:textColor="?android:textColorSecondary"
        android:layout_marginBottom="4dp" />

    <EditText
        android:id="@+id/edit_api_key"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:inputType="text"
        android:singleLine="true"
        android:hint="sk-xxxxxxxxxxxxxxxx"
        android:layout_marginBottom="16dp"
        android:paddingStart="12dp"
        android:paddingEnd="12dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="模型名称"
        android:textSize="14sp"
        android:textColor="?android:textColorSecondary"
        android:layout_marginBottom="4dp" />

    <EditText
        android:id="@+id/edit_model_name"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:inputType="text"
        android:singleLine="true"
        android:hint="gpt-3.5-turbo"
        android:layout_marginBottom="16dp"
        android:paddingStart="12dp"
        android:paddingEnd="12dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="16dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginEnd="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="最大 Tokens"
                android:textSize="14sp"
                android:textColor="?android:textColorSecondary"
                android:layout_marginBottom="4dp" />

            <EditText
                android:id="@+id/edit_max_tokens"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:inputType="number"
                android:hint="4096"
                android:paddingStart="12dp"
                android:paddingEnd="12dp" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="温度"
                android:textSize="14sp"
                android:textColor="?android:textColorSecondary"
                android:layout_marginBottom="4dp" />

            <EditText
                android:id="@+id/edit_temperature"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:inputType="numberDecimal"
                android:hint="0.7"
                android:paddingStart="12dp"
                android:paddingEnd="12dp" />

        </LinearLayout>

    </LinearLayout>

    <Button
        android:id="@+id/btn_save"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="保存设置"
        android:textSize="16sp" />

</LinearLayout>
